import {mkdirSync,realpathSync,existsSync} from 'node:fs';
import {resolve,dirname,sep} from 'node:path';
import {fileURLToPath} from 'node:url';
import {randomUUID} from 'node:crypto';
import {DatabaseSync} from 'node:sqlite';

export function openInstance({mustExist=false}={}){
 const profile=process.env.VORLDA_ENV||'development';
 if(!['development','production'].includes(profile))throw Error('VORLDA_ENV must be development or production.');
 if(process.env.PUBLIC_APP==='1'&&profile!=='production')throw Error('Public deployment requires VORLDA_ENV=production with its own database and credentials.');
 const root=dirname(fileURLToPath(import.meta.url));
 if(!process.env.VORLDA_DATA_DIR&&existsSync(resolve(root,'data','forms.sqlite')))throw Error('Legacy database found. Set VORLDA_DATA_DIR to its existing data directory and explicitly choose VORLDA_ENV before starting. No data was migrated or replaced.');
 const directory=resolve(process.env.VORLDA_DATA_DIR||resolve(root,'data',profile));
 if(mustExist&&!existsSync(resolve(directory,'forms.sqlite')))throw Error('No database exists for the selected environment.');
 mkdirSync(directory,{recursive:true,mode:0o700});
 const actual=realpathSync(directory),publicPath=resolve(root,'public');
 if(actual===root||actual===publicPath||actual.startsWith(publicPath+sep))throw Error('Runtime data must be outside the public directory and project root.');
 const db=new DatabaseSync(resolve(actual,'forms.sqlite'));
 db.exec('PRAGMA journal_mode=WAL; PRAGMA busy_timeout=5000; CREATE TABLE IF NOT EXISTS instance_meta(id INTEGER PRIMARY KEY CHECK(id=1),profile TEXT NOT NULL,instance_id TEXT NOT NULL);');
 db.prepare('INSERT INTO instance_meta(id,profile,instance_id) VALUES(1,?,?) ON CONFLICT(id) DO NOTHING').run(profile,randomUUID());
 const instance=db.prepare('SELECT * FROM instance_meta WHERE id=1').get();
 if(instance.profile!==profile){db.close();throw Error('This database belongs to a different environment. Do not copy testing data into production.');}
 db.exec('CREATE TABLE IF NOT EXISTS submissions(id TEXT PRIMARY KEY,piece_id TEXT NOT NULL,data TEXT NOT NULL,created_at INTEGER NOT NULL); CREATE TABLE IF NOT EXISTS limits(ip TEXT NOT NULL,window INTEGER NOT NULL,count INTEGER NOT NULL,PRIMARY KEY(ip,window));');
 return {db,profile,instanceId:instance.instance_id,directory:actual};
}
