const el=id=>document.getElementById(id);let session=null,items=[],next=null,epoch=0;
function message(text){el('status').textContent=text;}
function clearSensitive(){epoch++;items=[];next=null;el('responses').replaceChildren();el('responses-panel').hidden=true;el('password').reset();el('login').reset();}
async function api(path,body){const response=await fetch('/admin/api/'+path,{method:body===undefined?'GET':'POST',headers:body===undefined?{}:{'Content-Type':'application/json','X-CSRF-Token':session?.csrf||''},body:body===undefined?undefined:JSON.stringify(body)});const data=await response.json();if(!response.ok)throw Object.assign(Error(data.error||'تعذّر إتمام الطلب.'),{status:response.status});return data;}
async function loadResponses(after=0){const version=epoch,data=await api('responses?after='+after);if(version!==epoch||session?.scope!=='admin')return;items=data.items;next=data.next;el('responses').replaceChildren();if(!items.length){const note=document.createElement('p');note.textContent='لا توجد ردود في هذه الصفحة.';el('responses').append(note);}for(const item of items){const record=document.createElement('pre');record.textContent=new Date(item.created_at).toLocaleString('ar')+'\n'+JSON.stringify(item.data,null,2);el('responses').append(record);}el('next').hidden=next===null;}
async function render(){session=await api('session');if(session.scope!=='admin')clearSensitive();el('environment').textContent=session.profile==='development'?'بيئة اختبار مستقلة · لا تدمج بياناتها مع الإنتاج':'بيئة الإنتاج';el('login-panel').hidden=session.scope!=='preauth';el('init-note').hidden=session.initialized;el('password-panel').hidden=session.scope==='preauth';el('responses-panel').hidden=session.scope!=='admin';el('logout').hidden=session.scope==='preauth';el('password-title').textContent=session.scope==='bootstrap'?'عيّن كلمة مرورك قبل فتح الإدارة':'تغيير كلمة المرور';if(session.scope==='admin')await loadResponses();}
async function action(button,fn){button.disabled=true;message('');try{await fn();}catch(e){if(e.status===401){clearSensitive();try{await render();}catch{}}message(e.message);}finally{button.disabled=false;}}
el('login').addEventListener('submit',e=>{e.preventDefault();void action(e.submitter,async()=>{const values=Object.fromEntries(new FormData(e.target));session=await api('login',values);e.target.reset();await render();});});
el('password').addEventListener('submit',e=>{e.preventDefault();void action(e.submitter,async()=>{const values=Object.fromEntries(new FormData(e.target));if(values.newPassword!==values.confirmPassword)throw Error('كلمتا المرور غير متطابقتين.');delete values.confirmPassword;session=await api('password',values);e.target.reset();await render();message('تم تغيير كلمة المرور وإلغاء الجلسات القديمة.');});});
el('logout').onclick=()=>action(el('logout'),async()=>{await api('logout',{});clearSensitive();await render();});
el('refresh').onclick=()=>action(el('refresh'),()=>loadResponses());el('next').onclick=()=>action(el('next'),()=>loadResponses(next));
el('download').onclick=()=>{const url=URL.createObjectURL(new Blob([JSON.stringify(items,null,2)],{type:'application/json'})),link=document.createElement('a');link.href=url;link.download='form-responses-page.json';link.click();setTimeout(()=>URL.revokeObjectURL(url),1000);};
void render().catch(e=>message(e.message));
